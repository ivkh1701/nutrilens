# Supabase – get these from your project's Settings > API page
VITE_SUPABASE_URL=https://obkzeteppanhxflbonpf.supabase.co/rest/v1/
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# The Gemini API key and Supabase service-role key go into Supabase Edge Function
# secrets (never in .env or committed files):
#
#   supabase secrets set GEMINI_API_KEY=your-gemini-api-key
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# The service-role key is already injected automatically by Supabase into Edge
# Functions via the SUPABASE_SERVICE_ROLE_KEY env var — you only need to set it
# explicitly if you use a local dev override.
